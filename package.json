{
  "name": "dxg-pmp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "type-check": "npm run type-check --workspaces --if-present",
    "test": "node --test \"packages/*/src/**/*.test.ts\" \"apps/*/src/**/*.test.ts\"",
    "test:invariants": "node --test \"tests/invariants/**/*.test.ts\"",
    "ci": "npm run lint && npm run type-check && npm test",
    "db:up": "docker compose up -d postgres redis",
    "db:migrate": "node packages/db/src/migrate.ts && node scripts/ensureAppRole.ts",
    "db:seed": "node packages/db/src/seed.ts",
    "db:reset": "docker compose down -v && docker compose up -d postgres redis && node packages/db/src/waitFor.ts && node packages/db/src/migrate.ts && node scripts/ensureAppRole.ts && node packages/db/src/seed.ts",
    "dev:api": "node --watch apps/api/src/index.ts",
    "db:heartbeat": "node packages/db/src/heartbeat.ts",
    "demo:reset": "npm run db:seed && npm run db:heartbeat",
    "dev:web": "npm run dev -w @pmp/control-center",
    "dev": "concurrently -n api,web,portal,mail -c cyan,magenta,yellow,green \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:portal\" \"npm run dev:dispatcher\"",
    "dev:portal": "npm run dev -w @pmp/speaker-portal",
    "demo:link": "node scripts/speakerLink.mjs",
    "demo:totp": "node scripts/totp.mjs",
    "dev:dispatcher": "node apps/dispatcher/src/index.ts",
    "db:approle": "node scripts/ensureAppRole.ts",
    "db:verify-sizes": "node scripts/verifyFileSizes.ts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  }
}
