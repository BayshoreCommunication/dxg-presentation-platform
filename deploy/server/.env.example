# ── Presentation Management Platform · one-server production settings ──────────────────
# Copy to .env on the server (never commit the filled-in file). Every value is required
# unless marked optional. See docs/infra/PRODUCTION.md for where each one comes from.

# The two public addresses (DNS A/AAAA records must point at this server before start-up,
# so Caddy can obtain their certificates).
STAFF_HOST=pmp.av-rfpilot.com
PORTAL_HOST=speakers.av-rfpilot.com
# Let's Encrypt contact for certificate expiry notices.
ACME_EMAIL=ops@example.com

# Database. Two different long random passwords (e.g. `openssl rand -base64 32`).
PG_OWNER_PASSWORD=
PG_APP_PASSWORD=

# AWS — an IAM user limited to: this S3 bucket (Get/Put/List), SES SendEmail from MAIL_FROM.
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Private, versioned, encrypted bucket for presentations, PDFs, archives and backups.
S3_BUCKET=

# Email (SES, us-east-2, av-rfpilot.com already verified).
MAIL_FROM=noreply@av-rfpilot.com
MAIL_REPLY_TO=
SES_CONFIGURATION_SET=pmp-email
# optional: SNS topic ARN(s) allowed to post delivery/bounce events to /api/v1/webhooks/email
SNS_TOPIC_ARNS=

# optional: hour (UTC) of the nightly database backup; default 7 (≈ 2–3 am US Eastern)
BACKUP_HOUR_UTC=7
