# Copy to .env for local work. Never commit .env.
# The development defaults are safe: nothing leaves the machine.

# ── database (docker-compose) ────────────────────────────────────────────────
PGHOST=127.0.0.1
PGPORT=5434
PGUSER=pmp
PGPASSWORD=pmp_dev
PGDATABASE=pmp_dev

# ── files ────────────────────────────────────────────────────────────────────
FILE_ROOT=.data

# ── email ────────────────────────────────────────────────────────────────────
# `file` writes messages to .data/mail/ and sends nothing. `ses` sends for real.
MAIL_TRANSPORT=file

# Required when MAIL_TRANSPORT=ses — the transport refuses to start without them.
# AWS_REGION=us-east-2
# MAIL_FROM=noreply@av-rfpilot.com
#
# Strongly recommended: without a configuration set SES publishes no delivery,
# bounce or complaint events, and the platform believes every message landed.
# SES_CONFIGURATION_SET=pmp-email
#
# Only delivery events from these topics are accepted.
# SNS_TOPIC_ARNS=arn:aws:sns:us-east-2:295229565954:pmp-email-events
#
# The From domain is a vendor domain shared with RFPilot, so speakers get a real
# address to reply to. Note dxg-agency.com has NO MX records and cannot receive
# mail at all — an address there would bounce every reply (D-020).
# MAIL_REPLY_TO=dxgrfptool@gmail.com
# Credentials come from the standard AWS chain (instance role in production),
# never from this file.

# ── app URLs used in outgoing links ──────────────────────────────────────────
STAFF_BASE=http://localhost:3000
PORTAL_BASE=http://localhost:3001
